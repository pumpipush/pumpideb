# ─────────────────────────────────────────────────────────────────────────────
# Pumpi — Environment Variables Template
# Copy this file to .env and fill in the values before running on a VPS.
# NEVER commit the real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Replit this is auto-provisioned.
# On a VPS: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/pumpi

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Secret used to authenticate the /admin/* API routes and the admin dashboard.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Session / Auth ────────────────────────────────────────────────────────────
# Random secret for signing JWT sessions.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From https://console.cloud.google.com — OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Birdeye API ───────────────────────────────────────────────────────────────
# For token price/market cap enrichment. Get a key at https://birdeye.so
BIRDEYE_API_KEY=your_birdeye_api_key

# ── Object Storage ────────────────────────────────────────────────────────────
# Replit Object Storage bucket ID (auto-set on Replit; set manually on VPS).
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your_bucket_id
PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public

# ── Privy Auth (optional) ─────────────────────────────────────────────────────
# Only needed if using Privy wallet auth.
PRIVY_APP_SECRET=your_privy_app_secret

# ── Platform Config ───────────────────────────────────────────────────────────
# Solana wallet address that receives platform fees.
PLATFORM_TREASURY_ADDRESS=JBCqngc3TYcz3Rtv5Md3CZyw8X6AxLik7gswCCttRS5E
VITE_PLATFORM_FEE_RECIPIENT=JBCqngc3TYcz3Rtv5Md3CZyw8X6AxLik7gswCCttRS5E
VITE_PUMP_FEE_RECIPIENT=JBCqngc3TYcz3Rtv5Md3CZyw8X6AxLik7gswCCttRS5E

# ── CORS (production only) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API server.
# Example: ALLOWED_ORIGINS=https://pumpi.app,https://www.pumpi.app
ALLOWED_ORIGINS=https://yourdomain.com

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Optional / Advanced ───────────────────────────────────────────────────────
# LOG_LEVEL=info
# SKIP_DEEP_BACKFILL=true
# DRY_RUN=false
# VITE_SOLANA_RPC_URL=https://your-custom-rpc.com
