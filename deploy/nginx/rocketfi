server {
    listen 80;
    listen [::]:80;
    server_name rocketfi.app www.rocketfi.app;

    # Redirect HTTP → HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rocketfi.app www.rocketfi.app;

    # SSL — update paths to match your certbot/Let's Encrypt output
    ssl_certificate     /etc/letsencrypt/live/rocketfi.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rocketfi.app/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /var/www/rocketfi;
    index index.html;

    # ─── index.html — NEVER cache ───────────────────────────────────────────
    # Vite hashes every JS/CSS filename on each build, so the HTML file is the
    # only entry-point browsers need to re-fetch after a deploy.  A cached copy
    # of index.html that references old chunk filenames → blank white screen.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma        "no-cache";
        add_header Expires       "0";
        try_files $uri =404;
    }

    # ─── Hashed JS / CSS assets — cache for 1 year ──────────────────────────
    # Vite embeds a content hash in every asset filename (e.g. main.abc123.js),
    # so these are safe to cache forever; a new build produces new filenames.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ─── SPA catch-all — serve index.html for all routes ────────────────────
    location / {
        # Apply the same no-cache policy to the root so browsers always
        # re-fetch the HTML rather than a stale cached copy.
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma        "no-cache";
        add_header Expires       "0";
        try_files $uri $uri/ /index.html;
    }

    # ─── API reverse proxy ───────────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_cache_bypass $http_upgrade;
    }
}
