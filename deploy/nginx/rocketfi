# /etc/nginx/sites-available/rocketfi
#
# Nginx site config for pumpi.io + admin.pumpi.io
#
# Two server blocks:
#   pumpi.io       — rocketfi SPA + API proxy
#   admin.pumpi.io — admin dashboard SPA (separate subdomain)
#
# FRONTEND ROOT is a symlink: /opt/rocketfi/current
# ADMIN ROOT is a symlink:    /opt/rocketfi/admin-current
# Both are atomically swapped by deploy/deploy-frontend.sh on each release.
#
# First-time setup on a new VPS:
#   mkdir -p /opt/rocketfi/releases
#   Run deploy/deploy-frontend.sh once to create both symlinks.
#
# Reload after any change:
#   nginx -t && systemctl reload nginx

# ── Redirect HTTP → HTTPS (pumpi.io) ────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name pumpi.io www.pumpi.io;
    return 301 https://$host$request_uri;
}

# ── Redirect HTTP → HTTPS (admin.pumpi.io) ──────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name admin.pumpi.io;
    return 301 https://$host$request_uri;
}

# ── pumpi.io — main app ──────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pumpi.io www.pumpi.io;

    # SSL — Cloudflare Origin Certificate (Full Strict mode)
    ssl_certificate     /etc/nginx/ssl/pumpi.io.crt;
    ssl_certificate_key /etc/nginx/ssl/pumpi.io.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Symlink managed by deploy/deploy-frontend.sh — swapped atomically on each deploy
    root /opt/rocketfi/current;
    index index.html;

    # ── Token image proxy cache ──────────────────────────────────────────────
    # Images are content-addressed — cache at nginx level for 7 days so every
    # visitor after the first gets a disk-cached response (no object-storage RTT).
    location /api/storage/public-objects/ {
        proxy_pass             http://127.0.0.1:8080;
        proxy_http_version     1.1;
        proxy_set_header       Host $host;
        proxy_set_header       X-Real-IP $remote_addr;
        proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;

        proxy_cache            pumpi_images;
        proxy_cache_valid      200 7d;
        proxy_cache_valid      404 1m;
        proxy_cache_use_stale  error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock       on;
        add_header             X-Cache-Status $upstream_cache_status;

        # Manual cache bypass: curl -H "X-Purge-Cache: 1" <url>
        proxy_cache_bypass     $http_x_purge_cache;
        proxy_no_cache         $http_x_purge_cache;
    }

    # ── Analytics beacon — rate-limited to prevent DB spam ──────────────────
    location = /api/analytics/track {
        limit_req zone=track_limit burst=5 nodelay;
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host             $host;
        proxy_set_header   X-Real-IP        $remote_addr;
        proxy_set_header   X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── API reverse proxy ────────────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_set_header   X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_read_timeout 3600s;
        # Allow up to 10 MB uploads (token image + metadata for pump-ipfs-upload)
        client_max_body_size 10m;
    }

    # ── index.html — NEVER cache ─────────────────────────────────────────────
    # Vite hashes every JS/CSS filename; a cached index.html that references
    # old chunk names causes a blank white screen after deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma        "no-cache" always;
        add_header Expires       "0" always;
        try_files $uri =404;
    }

    # ── Hashed JS / CSS / font assets — immutable cache ──────────────────────
    location ~* \.(?:js|css|woff2?|ttf|eot)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ── SPA catch-all — return index.html for all client-side routes ─────────
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma        "no-cache" always;
        add_header Expires       "0" always;
        try_files $uri $uri/ /index.html;
    }
}

# ── admin.pumpi.io — admin dashboard ────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.pumpi.io;

    # SSL — use a wildcard cert (*.pumpi.io) or a separate cert for this subdomain.
    # If using Cloudflare Origin Certificates, generate a wildcard *.pumpi.io cert.
    ssl_certificate     /etc/nginx/ssl/pumpi.io.crt;
    ssl_certificate_key /etc/nginx/ssl/pumpi.io.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Symlink managed by deploy/deploy-frontend.sh — swapped atomically on each deploy
    root /opt/rocketfi/admin-current;
    index index.html;

    # ── Optional: IP allowlist — uncomment to restrict to your IP only ───────
    # allow 1.2.3.4;   # your office / VPN IP
    # deny all;

    # ── index.html — NEVER cache ─────────────────────────────────────────────
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma        "no-cache" always;
        add_header Expires       "0" always;
        try_files $uri =404;
    }

    # ── Hashed JS / CSS / font assets — immutable cache ──────────────────────
    location ~* \.(?:js|css|woff2?|ttf|eot|png|svg|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ── SPA catch-all — all unknown paths serve index.html ───────────────────
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma        "no-cache" always;
        add_header Expires       "0" always;
        try_files $uri $uri/ /index.html;
    }
}
