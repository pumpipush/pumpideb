# ── Build output ─────────────────────────────────────────────────────────────
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules

# ── Environment & Secrets ─────────────────────────────────────────────────────
# Never commit real env files — use .env.example as a template
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local

# GCS service account keys (VPS deployment)
secrets/
*.json.key
service-account*.json

# ── Replit internal (not useful outside Replit) ───────────────────────────────
.cache/
.local/
.config/

# Agent memory — internal AI assistant notes, not relevant to the codebase
.agents/

# ── Runtime state files ───────────────────────────────────────────────────────
# These are created at runtime and should never be committed
artifacts/.launchlab-deep-backfill-done
*.pid
*.seed

# ── User-uploaded screenshots / attached files ────────────────────────────────
# These are temporary files uploaded during development sessions
attached_assets/

# ── IDEs and editors ─────────────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── macOS / Windows ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log
yarn-error.log
/coverage
