{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "backfill:birdeye": "node ./build.mjs && node --enable-source-maps ./dist/scripts/birdeye-backfill.mjs",
    "backfill:launchlab-names": "node ./build.mjs && node --enable-source-maps ./dist/scripts/backfill-launchlab-names.mjs",
    "backfill:launchlab-supply": "node ./build.mjs && node --enable-source-maps ./dist/scripts/backfill-launchlab-supply.mjs",
    "migrate:merge-duplicate-profiles": "node ./build.mjs && node --enable-source-maps ./dist/scripts/merge-duplicate-profiles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cleanup:orphan-trades": "node ./build.mjs && node --enable-source-maps ./dist/scripts/cleanup-orphan-trades.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
}
