# ── REQUIRED ──────────────────────────────────────────────────────────────────

# TCP port the API server listens on.
PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/rocketfi

# Secret for signing JWT auth tokens. Use a long random string in production.
# Generate: openssl rand -base64 48
SESSION_SECRET=change-me-use-a-long-random-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Without this, all cross-origin requests are blocked in production.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── OBJECT STORAGE (Google Cloud Storage) ─────────────────────────────────────
# Path to a GCP service account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=/etc/rocketfi/gcs-service-account.json

# Your GCP project ID.
GCS_PROJECT_ID=your-gcp-project-id

# Comma-separated GCS bucket paths for public token images.
# Format: bucket-name/optional-prefix
PUBLIC_OBJECT_SEARCH_PATHS=your-bucket/public,your-bucket/token-images

# GCS path prefix for private user uploads (profile avatars, etc.)
PRIVATE_OBJECT_DIR=your-bucket/private

# ── SOLANA / TRADING ──────────────────────────────────────────────────────────
# Alchemy API key — used for the pumpapi.io fallback WebSocket RPC.
# Without this, the adapter falls back to free public RPCs (less reliable).
ALCHEMY_API_KEY=

# Alchemy API key exposed to the frontend bundle (Vite prefix required).
# Used for optional direct-RPC calls from the browser (swap simulation, etc.)
VITE_ALCHEMY_API_KEY=

# ── LAUNCHLAB BACKFILL ────────────────────────────────────────────────────────
# Set to 1 on fresh VPS deployments to skip the full historical scan.
# The hot + regular backfill still run and pick up live data going forward.
SKIP_DEEP_BACKFILL=1

# ── OPTIONAL: DATA ENRICHMENT ─────────────────────────────────────────────────
# Birdeye API key — enriches graduated/DEX tokens with USD prices + liquidity.
# Without this, USD prices show "—" for non-pump tokens.
BIRDEYE_API_KEY=

# ── OPTIONAL: AUTH PROVIDERS ──────────────────────────────────────────────────
# Google OAuth client ID (server-side). Required for "Sign in with Google".
GOOGLE_CLIENT_ID=

# Resend API key — sends email OTP login codes.
# Without this, email login is disabled; wallet login still works.
RESEND_API_KEY=

# ── OPTIONAL: ALERTS ──────────────────────────────────────────────────────────
# Slack webhook URL for stream health alerts (pumpapi.io fallback, watchdog fires).
SLACK_WEBHOOK_URL=

# ── OPTIONAL: PLATFORM FEES ──────────────────────────────────────────────────
# Solana wallet address that receives the 0.25% platform trading fee.
# Set this at build time in the frontend (VITE_PLATFORM_FEE_RECIPIENT).
# Server-side: used only for deposit routing.
PLATFORM_TREASURY_ADDRESS=

# ── OPTIONAL: LOGGING ─────────────────────────────────────────────────────────
# Pino log level. One of: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

NODE_ENV=production
