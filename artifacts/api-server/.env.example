# ── API Server Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values
# NEVER commit the real .env file to git

# ── Required ──────────────────────────────────────────────────────────────────

NODE_ENV=production

# Server port (default: 8080)
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/pumpi

# JWT signing secret — generate with: openssl rand -hex 64
SESSION_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Solana / Blockchain ────────────────────────────────────────────────────────

# Alchemy API key for Solana RPC (required for indexing)
ALCHEMY_API_KEY=

# ── Google Cloud Storage (for token images/metadata) ─────────────────────────
# VPS mode: set GOOGLE_APPLICATION_CREDENTIALS to your service account JSON path
# Replit mode: leave unset (Replit sidecar handles auth automatically)

GOOGLE_APPLICATION_CREDENTIALS=/opt/pumpi/secrets/gcs-service-account.json
GCS_PROJECT_ID=your-gcp-project-id
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-gcs-bucket-name
PUBLIC_OBJECT_SEARCH_PATHS=token-images,token-meta
PRIVATE_OBJECT_DIR=private

# ── Optional ──────────────────────────────────────────────────────────────────

# Birdeye API key for DEX token prices
BIRDEYE_API_KEY=

# Resend API key for OTP email sign-in
# If not set: dev mode logs OTP to console; production throws an error
RESEND_API_KEY=

# Google OAuth client ID (for "Sign in with Google")
GOOGLE_CLIENT_ID=

# Enable real-time streaming indexers (PumpSwap, Meteora, Orca, Raydium)
# Set to 1 on VPS to index live trades; leave unset on Replit (free RPC saturates)
# ENABLE_STREAMING_ADAPTERS=1

# Log level (default: info)
# LOG_LEVEL=debug
