# ── Frontend Build Environment Variables ─────────────────────────────────────
# These are baked into the frontend bundle at build time (VITE_* prefix)
# Set these before running: pnpm run build

# Base URL path (use / for root domain, /app for subdirectory)
BASE_PATH=/

# Alchemy API key for Solana RPC (wallet transactions, price lookups)
VITE_ALCHEMY_API_KEY=

# ── Platform Fee ──────────────────────────────────────────────────────────────
# Your Solana wallet address — receives 1% on all trades + flat fee on token creation
# If not set, NO fees are collected (all transactions go fee-free)
VITE_PLATFORM_FEE_RECIPIENT=YourSolanaWalletAddressHere

# ── Optional ──────────────────────────────────────────────────────────────────

# Google OAuth client ID (must match GOOGLE_CLIENT_ID on the API server)
# VITE_GOOGLE_CLIENT_ID=

# Custom Solana RPC URL (overrides Alchemy if set)
# VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
