# ── REQUIRED FOR BUILD ────────────────────────────────────────────────────────

# Your Solana wallet address that receives the 0.25% platform trading fee.
# Without this, pnpm run build will fail (all fees silently skipped in prod).
# To build without fees intentionally: ALLOW_MISSING_FEE_RECIPIENT=1 pnpm build
VITE_PLATFORM_FEE_RECIPIENT=YourSolanaWalletAddressHere

# ── REQUIRED FOR DEV SERVER (not needed for build) ────────────────────────────

# Port the Vite dev/preview server listens on.
PORT=5173

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Alchemy API key for browser-side Solana RPC calls (swap simulation, etc.)
VITE_ALCHEMY_API_KEY=

# Google OAuth client ID for "Sign in with Google" button in the browser.
VITE_GOOGLE_CLIENT_ID=

# Base path if serving under a subpath (e.g. /app). Defaults to /.
# BASE_PATH=/
